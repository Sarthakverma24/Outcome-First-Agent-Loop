<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.formi</groupId>
    <artifactId>controller</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Formi Outcome-First Controller — Day 1 Foundation</name>

    <properties>
        <!-- Target Java 17 LTS (JDK 17 is what Maven is configured with on this machine).
             JDK 25 is also installed; bump source/target here and in run.sh if upgrading. -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ── Dependency versions (all pinned, one line to defend each) ── -->

        <!-- Jackson: standard JSON library, wide ecosystem support,
             well-understood failure modes, no magic reflection. -->
        <jackson.version>2.17.1</jackson.version>

        <!-- sqlite-jdbc: embeds the native SQLite library in the jar, zero ops
             overhead, WAL mode gives safe concurrent reads from the health thread. -->
        <sqlite.version>3.46.0.0</sqlite.version>

        <!-- SLF4J simple: lightweight, writes to stderr, no config file needed.
             Enough for a service that runs once per scenario; replace with Logback
             if structured JSON logs are needed in production. -->
        <slf4j.version>2.0.13</slf4j.version>

        <!-- JUnit 5: modern test framework, parameterized tests, no JUnit 4 cruft. -->
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- JSON serialisation / deserialisation -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- SQLite JDBC driver (bundles the native .so/.dll) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- SLF4J simple backend (includes slf4j-api 2.x transitively).
             Force the api version to 2.x so we don't accidentally pick up the
             1.x api that sqlite-jdbc or other transitive deps might pull in. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <!-- Explicit api pin so maven shade doesn't mix 1.x and 2.x class files -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Test scope only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fat/shaded jar so run.sh only needs: java -jar controller.jar <URL> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.formi.controller.Main</mainClass>
                                </transformer>
                                <!-- Merge service-loader files from sqlite-jdbc, jackson, and slf4j-simple -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Merge module-info and other META-INF resources -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                            </transformers>
                            <!-- Drop signature files that break fat-jar validation -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JUnit 5 runner (Surefire 2.x only supports JUnit 4 by default) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
